# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/wecare_hospital
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wecare_hospital?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wecare_hospital

# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@wecare.com
ADMIN_PASSWORD=AdminPassword123!

# JWT Secret for Session Authentication
JWT_SECRET=wecare-hospital-production-jwt-secret-key-change-in-production
